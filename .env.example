# Only local/self-managed compute. No paid inference API.
FASHIONCLIP_BASE_URL=http://127.0.0.1:8001
FASHIONCLIP_PORT=8001
# Replace with a random secret of at least 32 ASCII characters.
FASHIONCLIP_API_TOKEN=
# Empty disables all external image URLs. The batch uses registered local itemId.
FASHIONCLIP_ALLOWED_HOSTS=
FASHIONCLIP_DEVICE=cpu
FASHIONCLIP_REVISION=main
FASHIONCLIP_OFFLINE=0
# FASHIONCLIP_PYTHON=C:/path/to/regular/python.exe
# FASHIONCLIP_CACHE_DB=C:/path/to/private/embeddings.sqlite3

# Optional Supabase connection; blank leaves existing local app intact.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Admin batch ONLY; never sent to a browser or used for user swipe writes.
SUPABASE_SERVICE_ROLE_KEY=
